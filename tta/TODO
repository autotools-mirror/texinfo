Check includes with iwyu.  Note that iwyu does not know when config.h
has to be included before a header that is replaced by a Gnulib header.
rm -rf ../res_iwyu_hdr
mkdir ../res_iwyu_hdr

for file in */*.h ; do bfile=`basename $file .h`; include-what-you-use -DDATADIR='"/usr"' -I ../ -I main $file 2>../res_iwyu_hdr/$bfile.2 ; done

for file in main/build_perl_info.h main/get_perl_info.h */build_html_perl_info.h *//build_html_perl_state.h */build_perl_tree_elements.h convert/get_converter_perl_info.h */get_perl_tree_elements.h ../perl/XSTexinfo/*/*.h ; do bfile=`basename $file .h`; include-what-you-use -I . -I main -I convert -D_LARGEFILE64_SOURCE -I /usr/lib/x86_64-linux-gnu/perl/5.42.2/CORE/ $file 2>../res_iwyu_hdr/$bfile.2 ; done

