PERL="@PERL@"
DIFF_OPTIONS="@DIFF_OPTIONS@"
HOST_IS_WINDOWS_VARIABLE="@HOST_IS_WINDOWS_VARIABLE@"
PERL_UNICODE_COLLATE_OK="@PERL_UNICODE_COLLATE_OK@"
